{
  "info": {
    "name": "QAOps | Extensions négatives et limites Reqres",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Quatre extensions aux dix scénarios principaux. Ces cas doivent être exécutés sur Reqres ; une réponse 401/403/429 est un blocage, pas un succès attendu."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const key=pm.environment.get(\"api_key\");",
          "if(key){pm.request.headers.upsert({key:\"x-api-key\",value:key});}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "API-N01 | Utilisateur inexistant",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/users/23",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu 404\",()=>pm.response.to.have.status(404));",
              "pm.test(\"Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Aucune donnée utilisateur\",()=>pm.expect(b).to.not.have.property(\"data\"));",
              "pm.test(\"Objet JSON vide\",()=>pm.expect(b).to.deep.equal({}));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-N02 | Page au-delà de la dernière page",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/users?page=999",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Page demandée conservée\",()=>pm.expect(b.page).to.equal(999));",
              "pm.test(\"Liste vide, aucun utilisateur inventé\",()=>pm.expect(b.data).to.be.an(\"array\").that.is.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-N03 | Connexion sans mot de passe",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"peter@klaven\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu 400\",()=>pm.response.to.have.status(400));",
              "pm.test(\"Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Erreur JSON structurée\",()=>pm.response.to.have.jsonSchema({type:\"object\",required:[\"error\"],properties:{error:{type:\"string\",minLength:1}}}));",
              "pm.test(\"Aucun jeton délivré\",()=>pm.expect(b).to.not.have.property(\"token\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-N04 | Inscription sans mot de passe",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"sydney@fife\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut attendu 400\",()=>pm.response.to.have.status(400));",
              "pm.test(\"Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Erreur JSON structurée\",()=>pm.response.to.have.jsonSchema({type:\"object\",required:[\"error\"],properties:{error:{type:\"string\",minLength:1}}}));",
              "pm.test(\"Aucun compte ni jeton retourné\",()=>{pm.expect(b).to.not.have.property(\"id\");pm.expect(b).to.not.have.property(\"token\");});"
            ]
          }
        }
      ]
    }
  ]
}