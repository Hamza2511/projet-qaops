{
  "info": {
    "name": "QAOps | Reqres CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const key=pm.environment.get(\"api_key\");",
          "if(key){pm.request.headers.upsert({key:\"x-api-key\",value:key});}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "API-01 | GET /users?page=2",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users?page=2",
        "description": "Contrat de démonstration historique Reqres /api/users. Les mutations ne prouvent pas une persistance."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Content-Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Schéma JSON utilisateurs\",()=>pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"page\", \"per_page\", \"total\", \"total_pages\", \"data\"], \"properties\": {\"page\": {\"type\": \"integer\"}, \"per_page\": {\"type\": \"integer\"}, \"total\": {\"type\": \"integer\"}, \"total_pages\": {\"type\": \"integer\"}, \"data\": {\"type\": \"array\", \"minItems\": 1, \"items\": {\"type\": \"object\", \"required\": [\"id\", \"email\", \"first_name\", \"last_name\", \"avatar\"], \"properties\": {\"id\": {\"type\": \"integer\"}, \"email\": {\"type\": \"string\", \"format\": \"email\"}, \"first_name\": {\"type\": \"string\"}, \"last_name\": {\"type\": \"string\"}, \"avatar\": {\"type\": \"string\", \"format\": \"uri\"}}}}}}));",
              "pm.test(\"Page et taille cohérentes\",()=>{pm.expect(b.page).to.eql(2);pm.expect(b.data.length).to.be.at.most(b.per_page);});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-02 | POST /users",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users",
        "description": "Contrat de démonstration historique Reqres /api/users. Les mutations ne prouvent pas une persistance.",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Sara Bennani\", \"job\": \"student\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\",()=>pm.response.to.have.status(201));",
              "pm.test(\"Content-Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Schéma JSON réponse\",()=>pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"name\", \"job\", \"id\", \"createdAt\"], \"properties\": {\"name\": {\"type\": \"string\"}, \"job\": {\"type\": \"string\"}, \"id\": {\"type\": \"string\"}, \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"}, \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"}}}));",
              "pm.test(\"Création et identifiant\",()=>{pm.expect(b.name).to.eql(\"Sara Bennani\");pm.expect(b.job).to.eql(\"student\");pm.expect(b.id).to.be.a(\"string\").and.not.empty;pm.expect(Number.isNaN(Date.parse(b.createdAt))).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-03 | PUT /users/2",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/2",
        "description": "Contrat de démonstration historique Reqres /api/users. Les mutations ne prouvent pas une persistance.",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Sara Bennani\", \"job\": \"QA engineer\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Content-Type JSON\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const b=pm.response.json();",
              "pm.test(\"Schéma JSON réponse\",()=>pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"name\", \"job\", \"updatedAt\"], \"properties\": {\"name\": {\"type\": \"string\"}, \"job\": {\"type\": \"string\"}, \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"}}}));",
              "pm.test(\"Mise à jour\",()=>{pm.expect(b.name).to.eql(\"Sara Bennani\");pm.expect(b.job).to.eql(\"QA engineer\");pm.expect(Number.isNaN(Date.parse(b.updatedAt))).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-04 | DELETE /users/2",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users/2",
        "description": "Contrat de démonstration historique Reqres /api/users. Les mutations ne prouvent pas une persistance."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 204\",()=>pm.response.to.have.status(204));",
              "pm.test(\"Corps vide\",()=>pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    }
  ]
}
